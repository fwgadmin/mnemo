{
  "name": "mnemo-note",
  "version": "2.1.19",
  "description": "AI-native memory layer — notes, embeddings, and MCP for intelligence systems",
  "main": ".webpack/main/index.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwgadmin/mnemo.git"
  },
  "bugs": {
    "url": "https://github.com/fwgadmin/mnemo/issues"
  },
  "homepage": "https://github.com/fwgadmin/mnemo#readme",
  "files": [
    "README.md",
    "LICENSE",
    "bin",
    "dist",
    "examples",
    "scripts/rebuild-electron-native.js"
  ],
  "scripts": {
    "postinstall": "node scripts/rebuild-electron-native.js",
    "rebuild:native": "node scripts/rebuild-electron-native.js",
    "start": "node scripts/start-electron-forge.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win:trusted": "dotenv -e .env.trustedsigning -- electron-forge make",
    "build:mcp": "npx webpack-cli --config webpack.mcp.config.js",
    "build:mcp-http": "npx webpack-cli --config webpack.mcp-http.config.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:desktop",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "node scripts/run-electron-node.js node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:desktop": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest --config vitest.config.mts",
    "bench:category-model": "vitest bench --config vitest.config.mts src/renderer/categoryPath.bench.ts --run",
    "check": "npm run typecheck && npm run test:desktop && npm run typecheck --prefix apps/mnemo-mobile && git diff --check",
    "build:cli": "npx webpack-cli --config webpack.cli.config.js",
    "mobile:start:dev": "npm run start:dev --prefix apps/mnemo-mobile",
    "mobile:expo": "npm run start --prefix apps/mnemo-mobile",
    "eas:dev:ios": "npm run eas:dev:ios --prefix apps/mnemo-mobile",
    "eas:dev:android": "npm run eas:dev:android --prefix apps/mnemo-mobile",
    "eas:build:ios": "npm run eas:build:ios --prefix apps/mnemo-mobile",
    "eas:build:android": "npm run eas:build:android --prefix apps/mnemo-mobile",
    "eas:build:ios:simulator": "npm run eas:build:ios:simulator --prefix apps/mnemo-mobile",
    "eas:submit:ios": "npm run eas:submit:ios --prefix apps/mnemo-mobile",
    "eas:submit:android": "npm run eas:submit:android --prefix apps/mnemo-mobile",
    "prepublishOnly": "node scripts/verify-npm-package-readme.js && npm run typecheck && npm run build:cli && npm run build:mcp && npm run build:mcp-http"
  },
  "keywords": [
    "notes",
    "memory",
    "mcp",
    "rag",
    "ai"
  ],
  "author": {
    "name": "Ferrowood Group, LLC",
    "url": "https://www.ferrowoodgroup.com"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@electron/rebuild": "^4.1.0",
    "@formulajs/formulajs": "^4.6.1",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.8.1",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "electron": "^43.8.4",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
