    "remark-rehype": "11.1.2",
    "turndown": "7.2.4",
    "unified": "11.0.5",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/windows-sign": "^2.0.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "5.0.6",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.5.2",
    "css-loader": "^7.1.4",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.8.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^30.0.1",
    "node-loader": "^2.1.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.16",
    "postcss-loader": "^8.2.1",
    "sharp": "^0.35.3",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "bin": {
    "mnemo": "bin/mnemo.js",
    "mnemo-note": "bin/mnemo.js"
  },
  "overrides": {
    "tar": "^7.5.13",
    "tmp": "^0.2.5",
    "@tootallnate/once": "^3.0.1",
    "webpack-dev-server": "^5.2.6",
    "tailwindcss": "^3.4.19",
    "hono": "^4.12.26",
    "dompurify": "^3.4.11",
    "brace-expansion@^1": "^1.1.21",
    "js-yaml@^3": "^3.15.2",
    "js-yaml@^4": "^4.3.2",
    "postcss-selector-parser@^6": "^6.1.5",
    "postcss-selector-parser@^7": "^7.1.6",
    "ws@^8": "^8.21.0",
    "compression": "^1.8.2",
    "follow-redirects": "^1.16.2",
